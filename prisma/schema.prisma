generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── DEVIS & CLIENTS ────────────────────────────────────────────

model Collectif {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom             String
  contact         String
  email           String
  telephone       String?
  ville           String?
  typeCollectif   String
  tailleCollectif String
  usagesPrevus    String  @default("[]")
  besoinsNotes    String?

  statut  String  @default("PROSPECT")
  notes   String?
  source  String  @default("formulaire_site")

  quotes        Quote[]
  interactions  Interaction[]
  tasks         Task[]
}

model Quote {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  numero      String   @unique

  collectifId String
  collectif   Collectif @relation(fields: [collectifId], references: [id])

  planSlug    String
  planNom     String
  planCouleur String
  featuresJson String @default("[]")

  nombreUtilisateurs Int
  dureeContrat        Int
  remise              Float  @default(0)
  prixHT              Float
  prixTTC             Float
  mentionPrix         String?

  statut      String   @default("BROUILLON")
  validUntil  DateTime?

  signedAt      DateTime?
  signatureData String?
  signedByName  String?
  signedByRole  String?

  pdfPath         String?
  pdfGeneratedAt  DateTime?

  sentAt  DateTime?
  sentTo  String?

  // Acceptation des documents contractuels à la signature
  termsAcceptedAt DateTime?
  acceptedDocs    String?  // JSON : slugs des documents acceptés (ex. ["cgv","dpa","sla"])

  // Code promo appliqué à la signature
  promoCode    String?
  promoPercent Float?
}

// ── BLOG (articles, ex-WordPress) ──────────────────────────────

model Article {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  slug           String   @unique
  titre          String
  excerpt        String?
  contenu        String   // HTML fidèle (importé de WP, éditable dans l'admin)
  imageUrl       String?
  categorie      String?  // slug de catégorie (ex. entreprise-article)
  categorieLabel String?
  auteur         String?
  seoTitre       String?
  seoDescription String?
  publishedAt    DateTime
  featured       Boolean  @default(false) // "à la une" sur la homepage
  actif          Boolean  @default(true)
}

// ── DOCUMENTS CONTRACTUELS (éditables depuis l'admin) ──────────

model LegalDocument {
  id        String   @id @default(cuid())
  slug      String   @unique // cgv | dpa | sla | pdd
  titre     String
  version   String   // ex. "30 mai 2026"
  contenu   String   // texte markdown-léger, rendu en page publique
  updatedAt DateTime @updatedAt
}

// ── CMS ────────────────────────────────────────────────────────

model CmsContent {
  id        String   @id @default(cuid())
  cle       String   @unique
  label     String
  valeur    String
  updatedAt DateTime @updatedAt
}

model Partner {
  id      String  @id @default(cuid())
  nom     String
  logoUrl String
  siteUrl String?
  actif   Boolean @default(true)
  ordre   Int     @default(0)
}

model Testimony {
  id     String  @id @default(cuid())
  texte  String
  auteur String
  role   String
  actif  Boolean @default(true)
  ordre  Int     @default(0)
}

model TeamMember {
  id       String  @id @default(cuid())
  nom      String
  poste    String
  equipe   String
  photoUrl String?
  actif    Boolean @default(true)
  ordre    Int     @default(0)
}

// ── PLANS TARIFAIRES ───────────────────────────────────────────

model Plan {
  id          String  @id @default(cuid())
  slug        String  @unique
  nom         String
  couleur     String
  description String
  prixAnnuel  Float
  mention     String?
  actif       Boolean @default(true)
  ordre       Int     @default(0)

  planFeatures PlanFeature[]
}

model Feature {
  id    String @id @default(cuid())
  slug  String @unique
  nom   String
  ordre Int    @default(0)

  planFeatures PlanFeature[]
}

model PlanFeature {
  id        String  @id @default(cuid())
  planId    String
  featureId String
  valeur    Boolean @default(false)

  plan    Plan    @relation(fields: [planId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([planId, featureId])
}

// ── NEWSLETTER ─────────────────────────────────────────────────

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  email       String   @unique
  prenom      String?
  source      String   @default("site") // site | crm | import
  actif       Boolean  @default(true)
  unsubscribedAt DateTime?
}

// ── CODES PROMO ────────────────────────────────────────────────

model PromoCode {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  code        String    @unique
  pourcentage Float
  description String?
  actif       Boolean   @default(true)
  expiresAt   DateTime?
  usageMax    Int?
  usageCount  Int       @default(0)
}

// ── CRM — activité & relances ──────────────────────────────────

// Journal des échanges avec un collectif (note, appel, email, réunion)
model Interaction {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  collectifId String
  collectif   Collectif @relation(fields: [collectifId], references: [id], onDelete: Cascade)
  type        String    @default("NOTE") // NOTE | APPEL | EMAIL | REUNION
  contenu     String
  auteur      String?
  date        DateTime  @default(now())

  @@index([collectifId])
}

// Tâche / relance, éventuellement rattachée à un collectif
model Task {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  titre       String
  description String?
  dueDate     DateTime?
  done        Boolean    @default(false)
  priorite    String     @default("NORMALE") // BASSE | NORMALE | HAUTE
  collectifId String?
  collectif   Collectif? @relation(fields: [collectifId], references: [id], onDelete: Cascade)

  @@index([done, dueDate])
}

// ── AUTH ADMIN ─────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nom          String
  role         String    @default("EDITOR")
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

// ── SYSTÈME RDV ────────────────────────────────────────

model RdvDisponibilite {
  id          String  @id @default(cuid())
  jourSemaine Int     // 1=Lundi ... 5=Vendredi
  heureDebut  String  // "09:00"
  heureFin    String  // "18:00"
  dureeMinutes Int    @default(30)
  actif       Boolean @default(true)
}

model RdvReservation {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  date         String   // "2026-06-15"
  heure        String   // "14:00"
  nom          String
  email        String
  telephone    String?
  organisation String?
  sujet        String
  message      String?
  statut       String   @default("EN_ATTENTE") // EN_ATTENTE | CONFIRME | ANNULE
  noteAdmin    String?
}
