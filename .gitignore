# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …mais on livre le modèle (sans secrets) pour la reprise du projet
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# CLAUDE.md est versionné : c'est le point d'entrée auto-lu par Claude Code
# (index de reprise + contexte projet). On garde seulement le fichier perso local ignoré.
CLAUDE.local.md
.claudeignore
.claude/
SETUP_PROMPT.md
/memory

# Screenshots et fichiers d'audit Claude
/.playwright-mcp/
/*.png
/*.json
!vercel.json
/*.pdf
/audit-*
/.audit/
/.mcp.json
.agents/
skills-lock.json
/generated/prisma

# Base SQLite locale (dev uniquement — PostgreSQL en prod)
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal

# Uploads devis (générés en runtime)
/public/uploads/
*.png

# Sources & fichiers de travail locaux (affiches, médias, captures, persos) — non versionnés
/local-assets/
