# ─────────────────────────────────────────────────────────────────────────
# Uvibes — variables d'environnement (modèle)
# Copier ce fichier en `.env.local` et remplir les valeurs.
# Ne JAMAIS committer `.env` / `.env.local` (déjà gitignorés).
# ─────────────────────────────────────────────────────────────────────────

# ── CMS WordPress headless (contenu : blog, témoignages, partenaires…) ──
# Base de l'API REST WordPress, ex. https://wp.uvibes.fr/wp-json/wp/v2
NEXT_PUBLIC_API_URL=

# ── URLs publiques ──
# URL canonique du site (SEO, liens emails, désinscription newsletter)
NEXT_PUBLIC_SITE_URL=https://uvibes.fr
# CDN médias (vidéos/podcast) — base CloudFront, ex. https://xxxx.cloudfront.net
NEXT_PUBLIC_CLOUDFRONT_URL=

# ── Google Analytics (GA4) ──
# Identifiant de mesure G-XXXXXXXXXX. Optionnel : si vide, GA ne se charge pas.
# Consent Mode v2 : refusé par défaut, accordé via le bandeau cookies.
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# ── Base de données PostgreSQL / Supabase (DÉDIÉE à Uvibes, ≠ projet bizz) ──
# Lues par Prisma via prisma/schema.prisma (env()).
# DATABASE_URL = pooler (port 6543, runtime) ; DIRECT_URL = direct (port 5432, migrations).
# En local, DIRECT_URL peut être injoignable → appliquer le schéma avec `db push` sur le pooler.
DATABASE_URL=
DIRECT_URL=

# ── Auth admin (iron-session) ──
# Secret de chiffrement du cookie de session — chaîne aléatoire ≥ 32 caractères.
IRON_SESSION_SECRET=
# NB : le mot de passe admin n'est PAS ici — il vit dans la table AdminUser (bcrypt).

# ── Cron (Vercel) ──
# Protège les endpoints planifiés (rappels RDV : /api/rdv/reminders).
# Vercel envoie `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# ── Email — relais SMTP Brevo (transac : devis, RDV, codes promo, newsletter) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=            # login SMTP Brevo (ex. 8xxxxx@smtp-brevo.com)
SMTP_PASS=            # clé SMTP Brevo
# Expéditeur affiché (doit être un domaine vérifié dans Brevo : SPF/DKIM/DMARC)
MAIL_FROM="Uvibes" <contact@uvibes.fr>
# Boîte interne recevant les notifications (devis signé, nouveau RDV…). Optionnel.
NOTIFY_EMAIL=contact@uvibes.fr

# ── Brevo — API Contacts (synchro de la liste newsletter) ──
# Optionnel : si vide, l'inscription DB fonctionne mais sans synchro Brevo.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=

# ─────────────────────────────────────────────────────────────────────────
# OBSOLÈTE — ne plus utiliser (ancien envoi Gmail OAuth, remplacé par Brevo) :
#   EMAIL_USER, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN,
#   ADMIN_PASSWORD
# Ces variables ne sont plus lues par le code et peuvent être supprimées.
# ─────────────────────────────────────────────────────────────────────────
